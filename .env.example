# Porta HTTP do servidor
PORT=3000
# Pasta onde fica o banco SQLite (use um disco persistente na nuvem)
DATA_DIR=./data
# Primeiro administrador (criado apenas se não existir nenhum usuário)
ADMIN_USER=admin
ADMIN_PASSWORD=TroqueEstaSenha2026
# Chave da API da Anthropic para a análise com IA (opcional; também pode ser cadastrada em Configurações)
ANTHROPIC_API_KEY=
# Carregar dados de demonstração na primeira execução (true/false)
SEED_DEMO=true
# Duração da sessão em dias
SESSION_DAYS=7
