# Variáveis extras da API px-api na VM.
# Adicione ao serviço "functions" do docker-compose.yml do Supabase (em environment: ou env_file: ./functions.env).
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY o compose do Supabase já injeta.
# Nunca coloque este arquivo preenchido no Git.

# Planilha CONTROLE DE AÇÕES (app do Entra ID). Também podem ser salvos na tela Configurações.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Transcrição de áudio (opcional)
AZURE_SPEECH_KEY=
AZURE_SPEECH_ENDPOINT=brazilsouth

# Análise com IA (opcional)
ANTHROPIC_API_KEY=
