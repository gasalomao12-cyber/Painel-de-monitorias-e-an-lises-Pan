# PX Monitorias — configuração do servidor (copie para /etc/px-monitorias/px.env, chmod 600, dono px).
# Nunca coloque este arquivo preenchido no Git.

# Banco PostgreSQL (usuário dono do banco px_monitorias)
PX_DATABASE_URL=postgres://px:TROQUE_A_SENHA@127.0.0.1:5432/px_monitorias

# Segredo que assina os logins: 64 caracteres aleatórios (ex.: openssl rand -hex 32). Trocar derruba todas as sessões.
PX_JWT_SECRET=

# Endereço público da plataforma (links de áudio e de "esqueci minha senha")
PX_PUBLIC_URL=https://px.EMPRESA.com.br

# Onde o programa escuta (o Nginx faz o HTTPS e repassa para cá)
PX_HOST=127.0.0.1
PX_PORT=8080

# Pasta dos áudios da força-tarefa de queda (entra no backup)
PX_FILES_DIR=/var/lib/px-monitorias/arquivos

# Dias que a pessoa fica conectada sem digitar a senha de novo
PX_SESSION_DAYS=30

# E-mail do "esqueci minha senha" (opcional; sem ele, o administrador reseta a senha pela plataforma)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PX Monitorias <nao-responda@EMPRESA.com.br>

# Integrações (opcionais; também podem ser salvas na tela Configurações)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
AZURE_SPEECH_KEY=
AZURE_SPEECH_ENDPOINT=brazilsouth
ANTHROPIC_API_KEY=
